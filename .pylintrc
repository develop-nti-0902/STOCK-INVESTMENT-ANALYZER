
[REPORTS]
# 出力フォーマットをテキストに設定
output-format = text

[MASTER]
# tests ディレクトリは lint/型チェックの対象外とします
# （CI の一部チェックで tests を含めたくない方針のため）
ignore=tests

[MESSAGES CONTROL]
# 無関係な docstring の警告は抑制（プロジェクトポリシーで許容）
# broad-exception-caught は bulk save などで意図的に使用する場合に許容
disable=C0114,C0115,C0116,W0718
max-args=6
max-positional-arguments=6

[FORMAT]
max-line-length=79

[BASIC]
good-names=i,j,k,ex,Run,_,pk
