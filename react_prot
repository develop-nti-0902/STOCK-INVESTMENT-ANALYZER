                  </td>
                  <td className={`border border-gray-300 px-3 py-2 text-right whitespace-nowrap font-semibold ${row.priceChangePercent > 0 ? 'text-red-600' : row.priceChangePercent < 0 ? 'text-blue-600' : 'text-gray-600'}`}>
                    {row.priceChangePercent > 0 ? '+' : ''}{formatNumber(row.priceChangePercent)}%
                  </td>
                  <td className="border border-gray-300 px-3 py-2 text-right text-gray-600 whitespace-nowrap">{formatPrice(row.openPrice)}</td>
                  <td className="border border-gray-300 px-3 py-2 text-right text-gray-600 whitespace-nowrap">{formatPrice(row.highPrice)}</td>
                  <td className="border border-gray-300 px-3 py-2 text-right text-gray-600 whitespace-nowrap">{formatPrice(row.lowPrice)}</td>
                  <td className="border border-gray-300 px-3 py-2 text-right text-gray-600 whitespace-nowrap">{formatPrice(row.volume)}</td>
                  <td className="border border-gray-300 px-3 py-2 text-right text-gray-600 whitespace-nowrap">{formatPrice(row.tradingValue)}</td>
                  <td className="border border-gray-300 px-3 py-2 text-right text-gray-600 whitespace-nowrap">{formatPrice(row.marketCap)}</td>
                  <td className="border border-gray-300 px-3 py-2 text-right text-gray-600 whitespace-nowrap">{formatNumber(row.per)}</td>
                  <td className="border border-gray-300 px-3 py-2 text-right text-gray-600 whitespace-nowrap">{formatNumber(row.pbr)}</td>
                  <td className="border border-gray-300 px-3 py-2 text-right text-gray-600 whitespace-nowrap">{formatNumber(row.dividendYield)}</td>
                  <td className="border border-gray-300 px-3 py-2 text-right text-gray-600 whitespace-nowrap">{formatNumber(row.marginRatio)}</td>
                  <td className="border border-gray-300 px-3 py-2 text-right text-gray-600 whitespace-nowrap">{formatNumber(row.shortRatio)}</td>
                  <td className="border border-gray-300 px-3 py-2 text-right text-gray-600 whitespace-nowrap">{formatPrice(row.vwap)}</td>
                  <td className="border border-gray-300 px-3 py-2 text-gray-600 whitespace-nowrap">{row.marketCategory}</td>
                  <td className="border border-gray-300 px-3 py-2 text-gray-600 whitespace-nowrap">{row.sector}</td>
