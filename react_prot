      /* 実際のAPI呼び出し
      const params = new URLSearchParams();
      if (searchConditions.baseDate) params.append('base_date', searchConditions.baseDate);
      if (searchConditions.stockName) params.append('stock_name', searchConditions.stockName);
      if (searchConditions.stockCode) params.append('stock_code', searchConditions.stockCode);
      if (searchConditions.marketCategory) params.append('market_category', searchConditions.marketCategory);
      if (searchConditions.priceCondition) params.append('price_condition', 'true');

