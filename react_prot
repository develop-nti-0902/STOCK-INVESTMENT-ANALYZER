        {/* データなしメッセージ */}
        {!loading && tableData.length === 0 && (
          <div className="border-2 border-gray-300 p-8 text-center text-gray-500 rounded">
            検索条件を入力して検索ボタンを押してください
          </div>
        )}

        {/* ページャー */}
        {!loading && tableData.length > 0 && (
          <div className="mt-6 flex justify-between items-center">
            <div className="text-sm text-gray-600">
              全{tableData.length}件中 1-{tableData.length}件を表示
            </div>
            <div className="bg-blue-600 text-white px-6 py-2 rounded-lg flex items-center gap-2 shadow">
              <span className="font-bold text-lg">{tableData.length}</span>
              <span className="text-sm">件</span>
            </div>
          </div>
        )}
      </div>
    </div>
  );
}
