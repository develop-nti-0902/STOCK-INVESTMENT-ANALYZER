                  <td className="border border-gray-300 px-3 py-2 text-right text-gray-700 whitespace-nowrap font-semibold">{formatPrice(row.currentPrice)}</td>
                  <td className={`border border-gray-300 px-3 py-2 text-right whitespace-nowrap font-semibold ${row.priceChange > 0 ? 'text-red-600' : row.priceChange < 0 ? 'text-blue-600' : 'text-gray-600'}`}>
