# -----------------------------------------------------------------------------
# 開発用データベース関連のサンプル設定（スクリプトで利用します）
# - これらは例です。実際の環境では安全な値に置き換えてください。
# - スクリプトは位置引数を優先します。位置引数がない場合にここから読み込みます。
# -----------------------------------------------------------------------------
# スクリプトが参照する接続情報（管理者ユーザ）
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres_password_here

# 新規 DB を作成する際の設定（setup スクリプトで使用）
DB_NAME=stockdb
DB_USER=stock_user
DB_PASSWORD=stock_user_password_here

# テーブルスペースを配置するローカルディレクトリ（任意、空のままにすると位置引数が必要）
DB_DATA_DIR=

# テーブルスペース作成/削除をスキップする場合は 1 / true / yes を設定
SKIP_TABLESPACE=

# -----------------------------------------------------------------------------
# アプリケーション設定（例） - Pydantic Settingsで読み込みます
# -----------------------------------------------------------------------------
APP_NAME=STOCK-INVESTMENT-ANALYZER
APP_VERSION=0.1.0
# development / production / test のいずれか
ENV=development
DEBUG=true

# アプリケーションが参照するDB接続（上記スクリプト用設定と同値で構いません）
DB_HOST=${PGHOST}
DB_PORT=${PGPORT}
DB_NAME=${DB_NAME}
DB_USER=${DB_USER}
DB_PASSWORD=${DB_PASSWORD}

# 接続プール設定（SQLAlchemy Engine）
# - DB_POOL_SIZE: プール内の基本接続数（デフォルト: 5）
# - DB_MAX_OVERFLOW: 追加作成される接続の上限（デフォルト: 10）
# 例）高負荷時は適宜増減してください。Docker/本番では監視と併せてチューニング推奨。
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ログ設定
# NOTE: `LOG_FILE` を空にすると「ファイル出力」は行われません。
#       （コンソール出力は変わらず行われます。コンテナ運用では stdout に JSON を出す運用が推奨されます。）
LOG_LEVEL=INFO  # ログレベルに指定できる値: DEBUG, INFO, WARNING, ERROR, CRITICAL(大文字/小文字は区別されない)
LOG_FILE=app.log
LOG_DIR=logs
LOG_FORMAT=text
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# Repository / API limits
# 最大取得件数の上限（get_recent 等で使用）
MAX_RECENT_LIMIT=1000

# Yahoo Finance API設定
# Yahoo Finance APIのタイムアウト時間（秒）
YAHOO_FINANCE_TIMEOUT=30
# Yahoo Finance APIの最大リトライ回数
YAHOO_FINANCE_MAX_RETRIES=3
# リトライ時のバックオフ倍率
YAHOO_FINANCE_RETRY_BACKOFF=1.0
# Yahoo Finance APIの同時リクエスト数上限
YAHOO_FINANCE_CONCURRENCY_LIMIT=10

# -----------------------------------------------------------------------------
# EDINET API 設定
# - EDINET API の一部環境では `Subscription-Key` が必要です。
# - 実運用では `.env` に `EDINET_SUBSCRIPTION_KEY` を設定し、コード側で
#   環境変数から読み込むことを推奨します（git 管理しないこと）。
# 例: EDINET_SUBSCRIPTION_KEY=edff30e4028e4ba2a5871f8330cc1230
EDINET_SUBSCRIPTION_KEY=
# -----------------------------------------------------------------------------

# Batch Processing Settings
# JPX全銘柄一括取得時のバッチサイズ（1回の処理単位）
BATCH_BATCH_SIZE=100
# 並列実行時の最大同時処理数
BATCH_MAX_CONCURRENT=20
# 失敗時のリトライ回数
BATCH_RETRY_ATTEMPTS=3
# リトライ間の待機時間（秒）
BATCH_RETRY_DELAY=1.0
# HTTPリクエストのタイムアウト時間（秒）
BATCH_REQUEST_TIMEOUT=30
# 全体操作のタイムアウト時間（秒）
BATCH_OPERATION_TIMEOUT=3600
# レート制限の時間枠内のAPIコール数
BATCH_RATE_LIMIT_CALLS=2000
# レート制限の時間枠（秒）
BATCH_RATE_LIMIT_PERIOD=3600

# -----------------------------------------------------------------------------
# CORS 設定（フロントエンドとのクロスオリジン通信を許可するため）
# - `CORS_ALLOW_ORIGINS` は JSON 配列またはカンマ区切りで指定できます。
#   JSON 配列方式（推奨）: '["http://localhost:3000","http://127.0.0.1:3000"]'
#   カンマ区切り方式（簡易）: http://localhost:3000,http://127.0.0.1:3000
# - 本番ではワイルドカード("*") を避け、必要なオリジンのみ列挙してください。
# -----------------------------------------------------------------------------
CORS_ALLOW_ORIGINS='["http://localhost:3000","http://127.0.0.1:3000"]'
# Alternative (comma-separated):
# CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=true
# 許可するメソッド（デフォルト: "*"）
CORS_ALLOW_METHODS=*
# 許可するヘッダ（デフォルト: "*"）
CORS_ALLOW_HEADERS=*
