# -----------------------------------------------------------------------------
# 開発用データベース関連のサンプル設定（スクリプトで利用します）
# - これらは例です。実際の環境では安全な値に置き換えてください。
# - スクリプトは位置引数を優先します。位置引数がない場合にここから読み込みます。
# -----------------------------------------------------------------------------
# スクリプトが参照する接続情報（管理者ユーザ）
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres_password_here

# 新規 DB を作成する際の設定（setup スクリプトで使用）
DB_NAME=stockdb
DB_USER=stock_user
DB_PASSWORD=stock_user_password_here

# テーブルスペースを配置するローカルディレクトリ（任意、空のままにすると位置引数が必要）
DB_DATA_DIR=

# テーブルスペース作成/削除をスキップする場合は 1 / true / yes を設定
SKIP_TABLESPACE=

# -----------------------------------------------------------------------------
# アプリケーション設定（例） - Pydantic Settingsで読み込みます
# -----------------------------------------------------------------------------
APP_NAME=STOCK-INVESTMENT-ANALYZER
APP_VERSION=0.1.0
# development / production / test のいずれか
ENV=development
DEBUG=true

# アプリケーションが参照するDB接続（上記スクリプト用設定と同値で構いません）
DB_HOST=${PGHOST}
DB_PORT=${PGPORT}
DB_NAME=${DB_NAME}
DB_USER=${DB_USER}
DB_PASSWORD=${DB_PASSWORD}

# 接続プール設定（SQLAlchemy Engine）
# - DB_POOL_SIZE: プール内の基本接続数（デフォルト: 5）
# - DB_MAX_OVERFLOW: 追加作成される接続の上限（デフォルト: 10）
# 例）高負荷時は適宜増減してください。Docker/本番では監視と併せてチューニング推奨。
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ログ設定
# NOTE: `LOG_FILE` を空にすると「ファイル出力」は行われません。
#       （コンソール出力は変わらず行われます。コンテナ運用では stdout に JSON を出す運用が推奨されます。）
LOG_LEVEL=INFO  # ログレベルに指定できる値: DEBUG, INFO, WARNING, ERROR, CRITICAL(大文字/小文字は区別されない)
LOG_FILE=app.log
LOG_DIR=logs
LOG_FORMAT=text
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# Repository / API limits
# 最大取得件数の上限（get_recent 等で使用）
MAX_RECENT_LIMIT=1000
