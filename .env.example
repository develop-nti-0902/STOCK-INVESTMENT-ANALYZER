# -----------------------------------------------------------------------------
# 開発用データベース関連のサンプル設定（スクリプトで利用します）
# - これらは例です。実際の環境では安全な値に置き換えてください。
# - スクリプトは位置引数を優先します。位置引数がない場合にここから読み込みます。
# -----------------------------------------------------------------------------
# スクリプトが参照する接続情報（管理者ユーザ）
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres_password_here

# 新規 DB を作成する際の設定（setup スクリプトで使用）
DB_NAME=stockdb
DB_USER=stock_user
DB_PASSWORD=stock_user_password_here

# テーブルスペースを配置するローカルディレクトリ（任意、空のままにすると位置引数が必要）
DB_DATA_DIR=

# テーブルスペース作成/削除をスキップする場合は 1 / true / yes を設定
SKIP_TABLESPACE=

# -----------------------------------------------------------------------------
# アプリケーション設定（例） - Pydantic Settingsで読み込みます
# -----------------------------------------------------------------------------
APP_NAME=STOCK-INVESTMENT-ANALYZER
APP_VERSION=0.1.0
# development / production / test のいずれか
ENV=development
DEBUG=true

# アプリケーションが参照するDB接続（上記スクリプト用設定と同値で構いません）
DB_HOST=${PGHOST}
DB_PORT=${PGPORT}
DB_NAME=${DB_NAME}
DB_USER=${DB_USER}
DB_PASSWORD=${DB_PASSWORD}

# ログ設定
LOG_LEVEL=INFO
LOG_FILE=app.log
