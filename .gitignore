.claude/
AI_INSTRUCTIONS.md
.serena/
prompt.md

# vscode settings
.vscode/

# Hide the git directory in IDE/file explorers (optional)
# NOTE: Git always manages the .git directory internally; adding it here
# only affects ignored/untracked listing in tools and some IDEs.
.git/

# Python virtualenvs
.venv/
venv/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/

# Pytest cache
.pytest_cache/

# Coverage reports
.coverage
.coverage.*
htmlcov/
*.cover
.hypothesis/

# Environment variables file
.env

# Ignore runtime log file(s)
app.log
logs/

# e2e test artifacts (generated by tests, do not commit)
tests/e2e/artifacts/

# integration test artifacts (generated by tests, do not commit)
tests/integration/artifacts/
